COMPOSE_PROJECT_NAME=pickdata
TZ=Asia/Shanghai

MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_DATABASE=pickdata
MYSQL_USER=pickdata
MYSQL_PASSWORD=replace_with_app_password
MYSQL_PORT=3306

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=replace_with_redis_password
REDIS_PORT=6379

ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MINIO_ROOT_USER=pickdata
MINIO_ROOT_PASSWORD=replace_with_minio_password
MINIO_BUCKET=milvus
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_IMAGE=milvusdb/milvus:v2.5.9
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

ROCKETMQ_IMAGE=apache/rocketmq:5.3.2
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_HA_PORT=10909
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10912
